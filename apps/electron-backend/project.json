{
    "name": "electron-backend",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/electron-backend/src",
    "projectType": "application",
    "tags": [
        "scope:electron",
        "domain:electron-main",
        "type:app"
    ],
    "targets": {
        "build-worker": {
            "executor": "nx:run-commands",
            "outputs": [
                "{workspaceRoot}/dist/apps/electron-backend/workers"
            ],
            "options": {
                "command": "node apps/electron-backend/build-worker.js"
            }
        },
        "build-embedded-mpv": {
            "executor": "nx:run-commands",
            "cache": false,
            "outputs": [
                "{workspaceRoot}/apps/electron-backend/native/build/Release"
            ],
            "options": {
                "command": "node tools/ensure-native-inputs.mjs embedded-mpv",
                "envFile": "tools/native-toolchain.env"
            }
        },
        "build-ksplayer-metal": {
            "executor": "nx:run-commands",
            "cache": false,
            "outputs": [
                "{workspaceRoot}/apps/electron-backend/native/build/Release/ksplayer_metal.node",
                "{workspaceRoot}/apps/electron-backend/native/build/Release/ksplayer-metal-runtime.json",
                "{workspaceRoot}/apps/electron-backend/native/build/Release/ksplayer-metal/**"
            ],
            "options": {
                "command": "node tools/ensure-native-inputs.mjs ksplayer-metal",
                "envFile": "tools/native-toolchain.env"
            }
        },
        "build-native-players": {
            "executor": "nx:run-commands",
            "cache": false,
            "options": {
                "commands": [
                    "nx run electron-backend:build-ksplayer-metal",
                    "nx run electron-backend:build-embedded-mpv"
                ],
                "parallel": false
            }
        },
        "build": {
            "dependsOn": [
                "electron-backend:build-worker",
                "electron-backend:build-native-players"
            ],
            "executor": "nx-electron:build",
            "outputs": [
                "{options.outputPath}"
            ],
            "inputs": [
                "production",
                "^production",
                "{workspaceRoot}/apps/electron-backend/native/build/Release/**"
            ],
            "options": {
                "outputPath": "dist/apps/electron-backend",
                "main": "apps/electron-backend/src/main.ts",
                "tsConfig": "apps/electron-backend/tsconfig.app.json",
                "assets": [
                    "apps/electron-backend/src/assets",
                    {
                        "glob": "**/*",
                        "input": "apps/electron-backend/native/build/Release",
                        "output": "native",
                        "ignore": [
                            ".deps/**",
                            "obj.target/**",
                            "**/.deps/**",
                            "**/obj.target/**",
                            "obj/**",
                            "**/obj/**",
                            "**/*.pdb",
                            "**/*.iobj",
                            "**/*.ipdb",
                            "**/*.ilk",
                            "**/*.exp",
                            "**/*.lib",
                            "**/*.dll.a"
                        ]
                    }
                ]
            },
            "configurations": {
                "production": {
                    "optimization": true,
                    "extractLicenses": true,
                    "inspect": false,
                    "fileReplacements": [
                        {
                            "replace": "apps/electron-backend/src/environments/environment.ts",
                            "with": "apps/electron-backend/src/environments/environment.prod.ts"
                        }
                    ]
                }
            }
        },
        "build-dev": {
            "dependsOn": [
                "electron-backend:build-worker"
            ],
            "executor": "nx-electron:build",
            "outputs": [
                "{options.outputPath}"
            ],
            "inputs": [
                "default",
                "^default",
                "{workspaceRoot}/apps/electron-backend/native/build/Release/**"
            ],
            "options": {
                "outputPath": "dist/apps/electron-backend",
                "main": "apps/electron-backend/src/main.ts",
                "tsConfig": "apps/electron-backend/tsconfig.app.json",
                "webpackConfig": "tools/webpack/electron-dev.config.cjs",
                "assets": [
                    "apps/electron-backend/src/assets",
                    {
                        "glob": "**/*",
                        "input": "apps/electron-backend/native/build/Release",
                        "output": "native",
                        "ignore": [
                            ".deps/**",
                            "obj.target/**",
                            "**/.deps/**",
                            "**/obj.target/**",
                            "obj/**",
                            "**/obj/**",
                            "**/*.pdb",
                            "**/*.iobj",
                            "**/*.ipdb",
                            "**/*.ilk",
                            "**/*.exp",
                            "**/*.lib",
                            "**/*.dll.a"
                        ]
                    }
                ]
            }
        },
        "serve": {
            "executor": "nx:run-commands",
            "options": {
                "command": "nx run electron-backend:serve-electron"
            }
        },
        "serve-electron": {
            "dependsOn": [
                "electron-backend:build-worker",
                "electron-backend:build-native-players"
            ],
            "executor": "nx-electron:execute",
            "options": {
                "buildTarget": "electron-backend:build",
                "waitUntilTargets": [
                    "desktop-ui:serve"
                ]
            }
        },
        "serve-electron-dev": {
            "executor": "nx-electron:execute",
            "options": {
                "buildTarget": "electron-backend:build-dev",
                "inspect": false,
                "waitUntilTargets": [
                    "desktop-ui:serve"
                ]
            }
        },
        "package": {
            "dependsOn": [
                "desktop-ui:build",
                "electron-backend:build",
                "electron-backend:generate-builder-metadata"
            ],
            "executor": "nx-electron:make",
            "options": {
                "name": "electron-backend",
                "frontendProject": "desktop-ui",
                "sourcePath": "dist/apps",
                "outputPath": "dist/executables"
            }
        },
        "generate-builder-metadata": {
            "dependsOn": [
                "electron-backend:build"
            ],
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "{workspaceRoot}/package.json",
                "{workspaceRoot}/electron-builder.json",
                "{workspaceRoot}/tools/packaging/generate-electron-builder-metadata.mjs"
            ],
            "outputs": [
                "{workspaceRoot}/apps/electron-backend/src/app/options/electron-builder.metadata.generated.json",
                "{workspaceRoot}/dist/apps/electron-backend/package.json"
            ],
            "options": {
                "command": "node tools/packaging/generate-electron-builder-metadata.mjs",
                "cwd": "{workspaceRoot}"
            }
        },
        "lint": {
            "inputs": [
                "default"
            ],
            "command": "eslint \"apps/electron-backend/**/*.ts\""
        },
        "test": {
            "executor": "nx:run-commands",
            "cache": true,
            "inputs": [
                "default",
                "^default"
            ],
            "options": {
                "command": "TSX_TSCONFIG_PATH=tsconfig.base.json node --import tsx --test 'apps/**/*.spec.ts' 'libs/**/*.spec.ts'",
                "cwd": "{workspaceRoot}"
            }
        }
    }
}
