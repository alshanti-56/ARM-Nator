+half3 applyPictureAdjustments(half3 rgb, constant float4& picture [[ buffer(3) ]], constant float& gamma [[ buffer(4) ]]) {
+    const half brightness = half(1.0 + picture.x / 100.0);
+    const half contrast = half(1.0 + picture.y / 100.0);
+    const half blackLevel = half(picture.z / 400.0);
+    const half saturation = max(half(0.0), half(1.0 + picture.w / 100.0));
+    const half exponent = max(half(0.1), half(1.0 + gamma / 100.0));
+    rgb = pow(max(rgb * brightness * contrast + blackLevel, half3(0.0)), half3(exponent));
+    const half luma = dot(rgb, half3(0.2126, 0.7152, 0.0722));
+    return clamp(mix(half3(luma), rgb, saturation), half3(0.0), half3(1.0));
+}
