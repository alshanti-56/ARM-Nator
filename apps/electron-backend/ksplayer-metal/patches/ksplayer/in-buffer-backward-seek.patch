+    private func remember(packet: Packet) {
+        guard duration > 0,
+              options.inBufferBackwardSeek,
+              options.backwardSeekBufferDuration > 0,
+              let copy = packet.copyForSeekCache()
+        else {
+            return
+        }
+        let packetTime = packet.seconds - startTime.seconds
+        guard packetTime.isFinite, packetTime >= 0 else {
+            return
+        }
+        packetHistory.append(copy)
+        packetHistoryEndTime = max(packetHistoryEndTime, packetTime)
+        let cutoff = packetHistoryEndTime - options.backwardSeekBufferDuration
+        if cutoff > 0 {
+            let removeCount = packetHistory.prefix { packet in
+                packet.seconds - startTime.seconds < cutoff
+            }.count
+            if removeCount > 0 {
+                packetHistory.removeFirst(removeCount)
+            }
+        }
+    }
+
+    private func replayPacketHistory(to target: TimeInterval) -> Bool {
+        guard duration > 0,
+              options.inBufferBackwardSeek,
+              packetHistory.count > 1,
+              target.isFinite,
+              target >= 0
+        else {
+            return false
+        }
+        let currentTime = (mainClock().time - startTime).seconds
+        guard target + 0.05 < currentTime,
+              packetHistoryEndTime >= currentTime - 1
+        else {
+            return false
+        }
+
+        let keyframeIndex = packetHistory.lastIndex { packet in
+            packet.assetTrack.mediaType == .video &&
+                packet.isKeyFrame &&
+                packet.seconds - startTime.seconds <= target
+        }
+        guard let keyframeIndex else {
+            return false
+        }
+        let keyframeTime = packetHistory[keyframeIndex].seconds - startTime.seconds
+        let replayStart = max(0, keyframeTime - 1.0)
+        guard let startIndex = packetHistory.firstIndex(where: { packet in
+            packet.seconds - startTime.seconds >= replayStart
+        }),
+              packetHistory.last!.seconds - startTime.seconds >= currentTime - 0.5
+        else {
+            return false
+        }
+
+        // seek(time:) has already reset the decoder queues. Replaying the
+        // retained compressed packets rebuilds them without another network
+        // read; the format context remains at its previous read position.
+        for packet in packetHistory[startIndex...] {
+            if packet.assetTrack.mediaType == .video {
+                videoTrack?.putPacket(packet: packet)
+            } else if packet.assetTrack.mediaType == .audio {
+                audioTrack?.putPacket(packet: packet)
+            } else {
+                packet.assetTrack.subtitle?.putPacket(packet: packet)
+            }
+        }
+        return true
+    }
