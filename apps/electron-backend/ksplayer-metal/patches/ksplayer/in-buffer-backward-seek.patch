+    /// Make an independent packet reference for the short VOD rewind cache.
+    /// The active decoder queue owns the original packet; this reference keeps
+    /// its compressed bytes available after that queue consumes it.
+    func copyForSeekCache() -> Packet? {
+        guard let source = corePacket else {
+            return nil
+        }
+        let copy = Packet()
+        guard let destination = copy.corePacket,
+              av_packet_ref(destination, source) >= 0
+        else {
+            return nil
+        }
+        copy.assetTrack = assetTrack
+        return copy
+    }
