{
  "name": "arm-nator",
  "version": "0.31.0",
  "license": "MIT",
  "description": "ARM-Nator Apple Silicon IPTV player application.",
  "keywords": [
    "angular",
    "electron",
    "typescript",
    "player",
    "iptv",
    "video",
    "tv"
  ],
  "scripts": {
    "dev": "node tools/dev-electron.mjs",
    "verify:environment": "node tools/verify-environment.mjs",
    "diagnostics:playback": "node tools/playback-diagnostics.mjs",
    "rebuild:native": "electron-builder install-app-deps --platform darwin --arch arm64",
    "predev": "node tools/verify-environment.mjs && node tools/ensure-dev-native.mjs",
    "dev:native": "pnpm verify:environment && pnpm rebuild:native && pnpm exec nx run electron-backend:build-native-players",
    "prebuild": "pnpm verify:environment && pnpm rebuild:native",
    "build": "nx run-many -t build --projects=desktop-ui,electron-backend --configuration=production",
    "lint": "nx run-many -t lint --all",
    "test": "node tools/testing/run-node-tests.mjs",
    "test:native-switch": "electron tools/testing/native-player-switch.cjs",
    "test:angular": "node tools/testing/run-angular-tests.mjs",
    "prepackage": "pnpm verify:environment && pnpm rebuild:native && pnpm embedded-mpv:runtime && pnpm ksplayer-metal:build",
    "package": "ARM_NATOR_ADHOC_SIGN=1 nx run electron-backend:package --configuration=production",
    "embedded-mpv:runtime": "node tools/embedded-mpv/ensure-macos-runtime.mjs",
    "embedded-mpv:build": "nx run electron-backend:build-embedded-mpv",
    "ksplayer-metal:build": "nx run electron-backend:build-ksplayer-metal",
    "player-backend:compare": "electron tools/player-backend-comparison.mjs",
    "graphify:runs": "node tools/graphify-runs.mjs",
    "player:fixtures": "node tools/player-stream-fixtures.mjs",
    "clean": "rm -rf dist tmp apps/electron-backend/native/build",
    "preinstall": "node tools/verify-environment.mjs"
  },
  "private": true,
  "engines": {
    "node": "26.11.1",
    "pnpm": "12.11.2"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
  "packageManager": "pnpm@12.11.2+sha512.25a51652a196785af5f28bda6dfe8dc582ebefa4ac1d180221ce1390231c5fb76637822ea4b6e4633ce74acdcb0a77f725af11bad38177fdeddaee818a955cb9",
  "dependencies": {
    "@angular/animations": "22.2.2",
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
