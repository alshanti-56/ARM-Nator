  "scripts": {
    "dev": "nx serve electron-backend",
    "build": "nx run-many -t build --projects=desktop-ui,electron-backend --configuration=production",
    "lint": "nx run-many -t lint --all",
    "test": "node tools/testing/run-node-tests.mjs",
    "test:angular": "node tools/testing/run-angular-tests.mjs",
    "prepackage": "pnpm embedded-mpv:runtime && pnpm ksplayer-metal:build",
    "package": "ARM_NATOR_ADHOC_SIGN=1 nx run electron-backend:package --configuration=production",
    "embedded-mpv:runtime": "node tools/embedded-mpv/ensure-macos-runtime.mjs",
    "embedded-mpv:build": "nx run electron-backend:build-embedded-mpv",
    "ksplayer-metal:build": "nx run electron-backend:build-ksplayer-metal",
    "player-backend:compare": "node_modules/.pnpm/electron@41.7.2/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron tools/player-backend-comparison.mjs",
    "graphify:runs": "node tools/graphify-runs.mjs",
    "player:fixtures": "node tools/player-stream-fixtures.mjs",
    "clean": "rm -rf dist tmp apps/electron-backend/native/build"
  },
  "private": true,
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ],
