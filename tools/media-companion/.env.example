# Local owner-only example. The service prints a random pairing token at startup
# unless MEDIA_COMPANION_TOKEN is supplied.
MEDIA_COMPANION_HOST=127.0.0.1
MEDIA_COMPANION_PORT=4321
MEDIA_COMPANION_ALLOWED_HOSTS=iptv.example,192.168.1.20
MEDIA_COMPANION_ALLOWED_ORIGINS=http://localhost:5173
MEDIA_COMPANION_ENABLE_CONVERSION=0
MEDIA_COMPANION_FFMPEG=ffmpeg
MEDIA_COMPANION_FFPROBE=ffprobe

# Remote HTTPS reverse-proxy example (enable only behind a trusted proxy):
# MEDIA_COMPANION_HOST=0.0.0.0
# MEDIA_COMPANION_TRUSTED_HTTPS_PROXY=1
# MEDIA_COMPANION_PUBLIC_BASE_URL=https://media-companion.example
# MEDIA_COMPANION_ALLOWED_ORIGINS=https://player.example
# MEDIA_COMPANION_TOKEN=replace-with-a-random-token-at-least-24-bytes
